{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // `next typegen` owns the "include" list and re-adds ".next/dev/types" every run, so it
  // cannot be removed here — it is filtered out by "exclude" at the bottom instead. That
  // directory holds a dev-only route validator Next generates, and this project sets
  // noUnusedLocals/noUnusedParameters, which flag that generated file and fail both
  // `pnpm typecheck` and `next build` with errors in code we do not own.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/dev"]
}
