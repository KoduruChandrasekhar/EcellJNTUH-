# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Paths are unanchored so they match inside frontend/ as well as at the repo root.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing / audits
playwright-report
test-results
.lighthouseci

# original uncompressed assets (see assets-source/README.md)
/assets-source/**
!/assets-source/README.md
